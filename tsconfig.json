{
  // Node-side code: the CLI front end, the Playwright suites, their page
  // objects, and the build / screenshot tooling. Browser code in src/web is
  // checked by tsconfig.app.json; `npm run typecheck` runs both.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/cli", "tests", "scripts"]
}

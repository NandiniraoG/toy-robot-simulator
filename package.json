{
  "name": "toy-robot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Toy Robot Simulator - a robot moves on a 5x5 tabletop via PLACE/MOVE/LEFT/RIGHT/REPORT commands without falling off.",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "build": "npm run build:web && npm run build:cli",
    "build:web": "esbuild src/web/main.ts --bundle --format=iife --target=es2022 --sourcemap --outfile=dist/web/app.js",
    "build:cli": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli/main.js",
    "build:watch": "npm run build:web -- --watch",
    "start": "node dist/cli/main.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "playwright test --config=playwright.unit.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "screenshots": "playwright test --config=playwright.screenshots.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.0"
  }
}

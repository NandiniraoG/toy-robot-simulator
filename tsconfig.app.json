{
  // Browser-side application code: the domain rules plus the DOM wiring that
  // web/index.html loads. Gets the DOM lib and no Node types, so a stray
  // `process` or `node:fs` import in here is a compile error. The CLI front
  // end (src/cli) and the test/tooling code are Node-flavoured and are
  // checked by the root tsconfig.json instead.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/domain", "src/web"]
}

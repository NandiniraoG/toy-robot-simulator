{
  // Application code in src/: the domain rules plus the DOM wiring that
  // web/index.html loads. Browser-targeted, so it gets the DOM lib and no
  // Node types — the Node-flavoured test/tooling code is checked separately
  // by the root tsconfig.json.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
